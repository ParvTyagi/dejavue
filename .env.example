# Copy to .env.local. With FIXTURE_MODE=replay no keys are needed and no credits are used.
FIXTURE_MODE=replay        # replay | record | live
MAX_CREDITS_PER_AUDIT=6
MONTHLY_CREDIT_LIMIT=250   # live mode refuses audits when fewer than 20 remain
REPLAY_PACE_MS=700         # replay only: simulated time per search, so the live view is visible

SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Temporary frame store (Supabase Storage); frames live at most 15 minutes
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=dejavue-tmp

# Shared storage for serverless hosting (Upstash Redis). Leave empty to use a local SQLite file.
# Vercel's Upstash integration may set KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

DOSSIER_HMAC_SECRET=
