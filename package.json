{
  "name": "dejavue",
  "version": "0.1.0",
  "private": true,
  "description": "Find where and when a viral image or video really first appeared, using SerpApi search engines as evidence.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "screenshots": "node scripts/screenshot.mjs",
    "typecheck": "tsc --noEmit",
    "fixtures:hash": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/hash-test-images.ts",
    "fixtures:author": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/author-synthetic-fixtures.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@supabase/supabase-js": "^2.116.0",
    "@upstash/redis": "^1.38.4",
    "chrono-node": "^2.10.1",
    "exifr": "^7.1.3",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
